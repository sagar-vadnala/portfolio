# Copy to .env and fill in. Every variable is optional for the public site:
# without DATABASE_URL it serves the static content in content/*.ts.

# Public production URL, used for metadata, Open Graph, and the sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Database (enables /admin, contact-form leads, and analytics) ──────────────
# Runtime connection, e.g. Supabase's transaction pooler.
DATABASE_URL=
# Direct (non-pooled) connection for Prisma migrations.
DIRECT_URL=

# ── Admin dashboard ───────────────────────────────────────────────────────────
ADMIN_PASSWORD=
# Random 32-byte base64 string, e.g. `openssl rand -base64 32`
ADMIN_SESSION_SECRET=

# ── File uploads (resumes, certificates, photos) ─────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
